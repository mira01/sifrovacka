{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Specification of a game",
  "type": "object",
  "$defs": {
    "message": {
      "anyOf": [
        { "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "description": "plaintext message"
            }
          }
        },
        {
          "type": "object",
          "properties":{
            "image": {
              "type": "string",
              "description": "path to an image file"
            }
          }
        }
      ]
    },
    "reference": {
      "anyOf": [
        { "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "description": "plaintext message"
            }
          }
        },
        {
          "type": "object",
          "properties":{
            "image": {
              "type": "string",
              "description": "path to an image file"
            }
          }
        }
      ]
    },
    "move": {
          "type": "object",
          "properties": {
            "answer": {
              "type": "string",
              "minLength": 1
            },
            "assignment": {
              "type": "array",
              "uniqueItems": false,
              "minItems": 1,
              "items": {
                "$ref":"#/$defs/message"
              }
            },
            "next_state": {"$ref":"#/$defs/message"
            }
          },
          "required": [
            "answer",
            "assignment",
            "next_state"
          ]
        }
  },
  "properties": {
    "title": {
      "type": "string",
      "description": "Human readable name of the game"
    },
    "start": {
      "$ref": "#/$defs/reference"    
    },
    "time_starts_after": {
      "$ref": "#/$defs/reference"
    },
    "welcome": {
      "type": "array",
      "uniqueItems": false,
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/message"
      }
    },
    "bye": {
      "type": "array",
      "uniqueItems": false,
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/message"
      }
    },
    "moves": {
      "type": "object",
