{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Specification of a game",
  "type": "object",
  "$defs": {
    "message": {
      "anyOf": [
        { "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "description": "plaintext message"
            }
          }
        },
        {
          "type": "object",
          "properties":{
            "image": {
              "type": "string",
              "description": "path to an image file"
            }
          }
        }
      ]
    },
    "messages": {
      "type": "array",
      "uniqueItems": false,
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/message"
      }
    },
    "reference": {
      "anyOf": [
        {"const": "finish"},
        { "type": "object",
          "properties": {
            "puzzle": {
              "type": "string",
              "description": "name of a puzzle"
            }
          }
        },
        {
          "type": "object",
          "properties":{
            "move": {
              "type": "string",
              "description": "name of a move"
            }
          }
        }
      ]
    },
    "move": {
          "type": "object",
          "properties": {
            "answer": {
              "type": "string",
              "minLength": 1,
              "description": "the correct answer player is expected to enter"
            },
            "assignment": {
              "$ref":"#/$defs/messages",
              "description": "the task that is given to the player"
            },
            "next_state": {
              "$ref":"#/$defs/reference",
              "description": "when the player enter the correct answer, this field describes what game state is the user taken to. either another move, a puzzle or the game end"
            }
          },
          "required": [
            "answer",
            "assignment",
            "next_state"
          ]
        },
    "puzzle": {
          "type": "object",
          "properties": {
            "answer": {
              "type": "string",
              "minLength": 1
            },
            "assignment": {
              "$ref":"#/$defs/messages"
            },
            "hint": {
              "$ref": "#/$defs/messages",
              "description": "a list of messages that are sent to the player if he needs a bit of help with the task"
            },
            "next_state": {
              "$ref":"#/$defs/reference"
            }
          },
          "required": [
            "answer",
            "assignment",
            "next_state",
            "hint"
          ]
        }
  },
  "properties": {
    "title": {
      "type": "string",
      "description": "human readable name of the game"
    },
    "start": {
      "$ref": "#/$defs/reference"    
    },
    "time_starts_after": {
      "$ref": "#/$defs/reference"
    },
    "welcome": {
      "$ref":"#/$defs/messages"
    },
    "bye": {
      "$ref": "#/$defs/messages" 
    },
    "moves": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "$ref": "#/$defs/move"
      }
    },
    "puzzles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "$ref": "#/$defs/puzzle"
      }
    }
  },
  "required": [
    "title",
    "start",
    "time_starts_after",
    "welcome",
    "bye",
    "moves",
    "puzzles"
  ]
}
